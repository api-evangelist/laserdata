{
  "opencollection": "1.0.0",
  "info": {
    "name": "LaserData Cloud Audit Account Connectors API",
    "version": "0.0.66"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ld-api-key",
      "value": "{{ld-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connectors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available connectors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.laserdata.cloud/tenants/:tenant_id/divisions/:division_id/environments/:environment_id/deployments/:deployment_id/connectors",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "Tenant identifier"
              },
              {
                "name": "division_id",
                "value": "",
                "type": "path",
                "description": "Division identifier"
              },
              {
                "name": "environment_id",
                "value": "",
                "type": "path",
                "description": "Environment identifier"
              },
              {
                "name": "deployment_id",
                "value": "",
                "type": "path",
                "description": "Deployment identifier"
              },
              {
                "name": "type",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "1",
                "type": "path"
              },
              {
                "name": "results",
                "value": "10",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the connector catalog with availability and activation status for the deployment. Filter by `type` query parameter (`source` or `sink`)."
        },
        {
          "info": {
            "name": "Activate connector",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.laserdata.cloud/tenants/:tenant_id/divisions/:division_id/environments/:environment_id/deployments/:deployment_id/connectors/activate",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "Tenant identifier"
              },
              {
                "name": "division_id",
                "value": "",
                "type": "path",
                "description": "Division identifier"
              },
              {
                "name": "environment_id",
                "value": "",
                "type": "path",
                "description": "Environment identifier"
              },
              {
                "name": "deployment_id",
                "value": "",
                "type": "path",
                "description": "Deployment identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Activates a connector instance on the deployment. The instance starts in Pending status and transitions to Active once nodes process the task. Poll the connector list to confirm readiness."
        }
      ]
    }
  ],
  "bundled": true
}