{
  "opencollection": "1.0.0",
  "info": {
    "name": "LaserData Cloud Audit Account Payments API",
    "version": "0.0.66"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ld-api-key",
      "value": "{{ld-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Stripe setup intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.laserdata.cloud/tenants/:tenant_id/billing/payments/intents",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "Tenant identifier"
              }
            ]
          },
          "docs": "Creates a Stripe setup intent so the client can collect and attach a payment method for the tenant."
        },
        {
          "info": {
            "name": "Get payment method",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.laserdata.cloud/tenants/:tenant_id/billing/payments/method",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "Tenant identifier"
              }
            ]
          },
          "docs": "Returns the tenant's current payment provider and stored payment method metadata."
        },
        {
          "info": {
            "name": "Remove payment method",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.laserdata.cloud/tenants/:tenant_id/billing/payments/method",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "Tenant identifier"
              }
            ]
          },
          "docs": "Detaches the current payment method for the tenant."
        }
      ]
    }
  ],
  "bundled": true
}